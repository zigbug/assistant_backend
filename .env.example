# =============================================================================
# Assistant Backend — пример конфигурации
# =============================================================================
# Скопируй этот файл в .env и заполни своими значениями:
#   cp .env.example .env
#
# Файл .env добавлен в .gitignore и НЕ публикуется в git.
# В продакшене (Docker) значения читаются из этого файла командой:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d
# =============================================================================

# --- Аутентификация ---
# API-ключ для доступа к API. Используй длинную случайную строку.
# Генерация: openssl rand -hex 32
API_KEY=your-super-secret-api-key-change-me-in-production

# --- Сервер ---
# Порт HTTP-сервера (по умолчанию 8081, т.к. 8080 часто занят)
PORT=8081

# Хост: 0.0.0.0 = все интерфейсы (нужно в Docker), localhost = только локально
HOST=0.0.0.0

# --- MCP-сервер ---
# Секретный путь эндпоинта MCP (защита от сканирования, передаётся в MCP_PATH).
# Генерация: openssl rand -hex 8
MCP_SECRET_PATH=change-me-mcp-path

# --- База данных ---
# Код сейчас работает на SQLite. В Docker путь задаётся через DATA_DIR
# (см. docker-compose.prod.yml), локально по умолчанию используется
# платформенная директория данных.
# Переменная DATABASE_URL зарезервирована на будущее (переход на PostgreSQL).
